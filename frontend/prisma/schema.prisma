generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  image         String?
  emailVerified DateTime?
  role          Role      @default(OWNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tenants            Tenant[]
  owners             Owner[]
  paymentAttachments PaymentAttachment[]

  sessions Session[]
  accounts Account[]
  leases   Lease[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  apartment   Apartment? @relation(fields: [apartmentid], references: [id])
  apartmentid String?
  payments    Payment[]
  createdAt   DateTime   @default(now())
  Lease       Lease[]
}

model Owner {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  buildings Building[]

  Invite Invite[]
}

model Building {
  id         String      @id @default(uuid())
  name       String
  ownerId    String
  owner      Owner       @relation(fields: [ownerId], references: [id])
  apartments Apartment[]
  createdAt  DateTime    @default(now())
}

model Apartment {
  id         String   @id @default(uuid())
  label      String   @default("Dummy Apartment ")
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  tenants    Tenant[]

  Invite    Invite[]
  createdAt DateTime @default(now())
  leases    Lease[]
}

model Payment {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  amount      Float
  confirmed   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  Lease       Lease?              @relation(fields: [leaseId], references: [id])
  leaseId     String?
  attachments PaymentAttachment[]
}

model PaymentAttachment {
  id         String   @id @default(uuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id])
  fileName   String
  url        String
  method     String? // e.g., CHEQUE | NETBANK | UPI | OTHER
  reference  String? // cheque number or txn id
  createdAt  DateTime @default(now())

  @@index([paymentId])
}

enum Role {
  OWNER
  TENANT
  ADMIN
}

model Invite {
  id         String    @id @default(uuid())
  email      String
  role       Role
  token      String    @unique
  expiresAt  DateTime
  accepted   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id])

  ownerId String?
  owner   Owner?  @relation(fields: [ownerId], references: [id])
}

model Lease {
  id          String    @id @default(cuid())
  // tenant      User      @relation(fields: [tenantId], references: [id])
  tenantId    String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])
  apartmentId String

  startDate  DateTime
  endDate    DateTime?
  rentAmount Int
  dueDate    Int
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  payments   Payment[]
  invoices   Invoice[]
  user       User?     @relation(fields: [userId], references: [id])
  userId     String?
}

model Invoice {
  id        String    @id @default(uuid())
  leaseId   String
  lease     Lease     @relation(fields: [leaseId], references: [id])
  amount    Int
  dueDate   DateTime
  paidDate  DateTime?
  createdAt DateTime  @default(now())
}
