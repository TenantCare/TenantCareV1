generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenants   Tenant[]
}

model Building {
  id         Int         @id @default(autoincrement())
  name       String
  location   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  apartments Apartment[]
}

model Apartment {
  id         Int      @id @default(autoincrement())
  number     String
  buildingId Int
  tenantId   Int?     @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  building   Building @relation(fields: [buildingId], references: [id])
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
}

model Payment {
  id            Int           @id @default(autoincrement())
  tenantId      Int
  amount        Float
  date          DateTime
  status        PaymentStatus
  paymentMethod String
  chequeNumber  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
}

model Tenant {
  id        Int        @id @default(autoincrement())
  userId    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  apartment Apartment?
  payments  Payment[]
  user      User       @relation(fields: [userId], references: [id])
}

enum UserRole {
  TENANT
  ADMIN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}
